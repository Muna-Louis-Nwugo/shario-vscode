{
  "name": "shario-vscode",
  "displayName": "Shar",
  "description": "Shar IDE client",
  "version": "0.0.1",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shar.create",
        "title": "Shar: Create Session"
      },
      {
        "command": "shar.participate",
        "title": "Shar: Participate in Session"
      },
      {
        "command": "shar.connect",
        "title": "Shar: Connect (attach to an already-running server)"
      },
      {
        "command": "shar.updateServer",
        "title": "Shar: Update Server Binary"
      }
    ],
    "configuration": {
      "title": "Shar",
      "properties": {
        "shario.enableBeta": {
          "type": "boolean",
          "default": false,
          "description": "When updating the server binary, allow pre-release (beta) shario versions, not just stable releases."
        }
      }
    }
  },
  "dependencies": {
    "socket.io-client": "^4.0.0"
  }
}
